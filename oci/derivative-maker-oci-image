set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

PINNED_BASE_IMAGE="docker.io/library/debian:trixie-slim@sha256:cedb1ef40439206b673ee8b33a46a03a0c9fa90bf3732f54704f99cb061d2c5a"
UNFROZEN_BASE_IMAGE="docker.io/library/debian:trixie-slim"
FROZEN_SOURCES="${SOURCE_VOLUME}/build_sources/debian_stable_frozen_direct_clearnet.sources.in"

declare snapshot_label_value=""

## Resolve base image and validate frozen source prerequisites before pulling
if [[ "${BUILD_FRESHNESS:-frozen}" == "current" ]]; then
    BASE_IMAGE="${UNFROZEN_BASE_IMAGE}"
    snapshot_label_value="current"
    echo "Skipping source freeze injection and using unfrozen sources." >&2
elif [[ -f "${FROZEN_SOURCES}" && -n "${snapshot_ts:-}" ]]; then
    BASE_IMAGE="${PINNED_BASE_IMAGE}"
    snapshot_label_value="${snapshot_ts}"
    declare formatted_date
    formatted_date=$(date --utc --date="@${snapshot_ts}" '+%Y%m%dT%H%M%SZ')
else
    echo "Error: Unfrozen sources are not allowed for production builds!" >&2
    exit 1
fi

declare ctr
ctr=$(buildah from --arch "${TARGET_ARCH}" "${BASE_IMAGE}")

## Mounts build container rootlessly & directly via host kernel VFS during assembly. Industry standard.
declare rootfs
rootfs=$(buildah mount "$ctr")

if [[ -n "${formatted_date:-}" ]]; then
    sed "s|XXX_TS_XXX|${formatted_date}/|g" "${FROZEN_SOURCES}" > "${rootfs}/etc/apt/dm-frozen.sources"
    chmod 0644 "${rootfs}/etc/apt/dm-frozen.sources"
fi

## Executes bootstrap script via stdin inside ctr.
buildah run \
    --env OCI_USER="$OCI_USER" \
    --env HOST_USER_ID="$HOST_USER_ID" \
    "$ctr" -- bash < "${SOURCE_VOLUME}/oci/derivative-maker-oci-bootstrap"

## Configures OCI engine to run `/sbin/init`, discarding fragile hardcoded binary routes or entry scripts.
buildah config \
    --env container=oci \
    --env USER="${OCI_USER}" \
    --env HOME="/home/${OCI_USER}" \
    --env DM_UID="${HOST_USER_ID}" \
    --stop-signal SIGRTMIN+3 \
    --cmd "/sbin/init" \
    --label "${DM_SNAPSHOT_LABEL}=${snapshot_label_value}" \
    --label org.opencontainers.image.authors="tabletseeker-git@protonmail.com" \
    --label org.opencontainers.image.description="Containerization of derivative-maker" \
    --label org.opencontainers.image.title="derivative-maker-oci" \
    --label org.opencontainers.image.source="https://github.com/tabletseeker/whonix-cloud" \
    --label org.opencontainers.image.documentation="https://github.com/tabletseeker/whonix-cloud/tree/master/oci" \
    --label org.opencontainers.image.version="1.0" \
    --label org.opencontainers.image.vendor="tabletseeker@github" \
    "$ctr"

buildah unmount "$ctr"
buildah commit --format oci "$ctr" "${IMAGE_REF}"
buildah rm "$ctr"

